#import "types"
#import "std/vec"
#import "ogg"
#import "wav"
#program_export
main :: () -> s32 {
    bytes: Vec(u8)
    header: [19]u8
    text := "OpusHead"
    for i: 0..7 { header[i] = text[i] }
    header[8] = 1; header[9] = 1
    PutLittle(header[:], 10, 2, 312); PutLittle(header[:], 12, 4, 44100)
    if AppendPage(*bytes, header[:], 2, 0, 77, 0) != OK { return 1 }
    tags: [16]u8
    text = "OpusTags"
    for i: 0..7 { tags[i] = text[i] }
    if AppendPage(*bytes, tags[:], 0, 0, 77, 1) != OK { return 2 }
    packet: [3]u8 = .[248, 255, 254]
    if AppendPage(*bytes, packet[:], 4, 812, 77, 2) != OK { return 3 }
    info: Info
    if Inspect(VecSlice(bytes, 0, bytes.count), *info) != OK || info.frames != 500 || info.pre_skip != 312 { return 4 }
    bytes[bytes.count - 1] ^= 1
    if Inspect(VecSlice(bytes, 0, bytes.count), *info) != Malformed || info.frames != 0 { return 5 }
    pcm: PCM
    pcm.channels = 1; pcm.rate = 8000
    if !VecResize(pcm.samples, 3) { return 6 }
    pcm.samples[0] = -1.0; pcm.samples[1] = 0.5; pcm.samples[2] = 32767.0 / 32768.0
    if WavEncode(*pcm, *bytes) != OK { return 7 }
    decoded: PCM
    if WavDecode(VecSlice(bytes, 0, bytes.count), 3, *decoded) != OK || decoded.samples.count != 3 { return 8 }
    for i: 0..2 { if decoded.samples[i] != pcm.samples[i] { return 9 } }
    print("portable audio contracts passed\n")
    return 0
}
