#import "types"
#import "std/audio_types"
#import "opus"
#import "resample"
#import "std/vorbis_linux"
#program_export
Codec :: () -> s32 {
    encoder: Encoder
    code := EncoderOpen(*encoder, 1, DefaultOptions())
    EncoderClose(*encoder)
    return code
}
#program_export
Sinc :: () -> s32 {
    state: SincState
    code := SincOpen(*state, 1, 44100, 48000)
    SincClose(*state)
    return code
}
#program_export
Vorbis :: () -> s32 {
    decoder: VorbisDecoder
    input: [4]u8
    code := VorbisDecoderOpen(*decoder, input[:], 1)
    VorbisDecoderClose(*decoder)
    return code
}
